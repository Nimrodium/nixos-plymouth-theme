
[Plymouth Theme]
Name=nixos-splash
Description=Boot animation with the NixOS logo, inspired by the boot animation of macOS.
ModuleName=two-step

[two-step]
ImageDir=@IMAGES@

# ImageDir=/home/kyle/repo/nixos-plymouth-theme/src/nixos-splash/images/

DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7

TitleHorizontalAlignment=.0
TitleVerticalAlignment=.0

HorizontalAlignment=0.5
VerticalAlignment=.65

WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.98

# Transition=
TransitionDuration=5

BackgroundStartColor=0x000000
BackgroundEndColor=0x222233

ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.59

ProgressBarWidth=350
ProgressBarHeight=5

ProgressBarBackgroundColor=0x333333
ProgressBarForegroundColor=0xffffff

ProgressFunction=wwoods

DialogClearsFirmwareBackground=true

MessageBelowAnimation=true

[boot-up]
UseEndAnimation=true
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=true
UseFirmwareBackground=false
Title=Shutting Down...

[reboot]
UseEndAnimation=true
UseFirmwareBackground=false

[updates]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Please do not turn off your computer.

[system-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Upgrades...
SubTitle=Please do not turn off your computer.

[firmware-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Firmware Updates...
SubTitle=Please do not turn off your computer.
